# Official TiPg image
FROM ghcr.io/developmentseed/tipg:1.3.0

# Set environment variables
ENV VECTOR_API_PORT=8083
ENV HOST=0.0.0.0
ENV DUCKDB_DATA_DIR=/data/duckdb

# Install DuckDB and related dependencies for Parquet/GeoParquet support
COPY vector-api/requirements-vector-api.txt /tmp/requirements-vector-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-vector-api.txt \
&& rm /tmp/requirements-vector-api.txt

# Copy canonical wait-for-it script and entrypoint
COPY scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY vector-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/wait-for-it.sh /usr/local/bin/entrypoint.sh

# Copy custom application code
COPY vector-api/src /app/vector_api

# Expose port for vector API
EXPOSE ${VECTOR_API_PORT}

# Command to wait for the database to be ready before starting the API
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
