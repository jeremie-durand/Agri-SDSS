FROM python:3.11-slim

# Set environment variables
ENV PYGEOAPI_API_PORT=5000
ENV PYGEOAPI_API_HOST=0.0.0.0
ENV PYGEOAPI_CONFIG=/app/config/pygeoapi-config.yaml
ENV PYGEOAPI_OPENAPI=/app/openapi/openapi.yaml
ENV PYTHONPATH=/app:${PYTHONPATH}

WORKDIR /app

# Copy files
COPY config/pygeoapi-config.yaml /app/config/pygeoapi-config.yaml
COPY processes /app/processes
COPY scripts/start.sh /usr/local/bin/start.sh
COPY scripts/generate_openapi.py /app/generate_openapi.py
COPY requirements-mos-pygeoapi.txt /tmp/requirements-mos-pygeoapi.txt

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
        build-essential \
        libgdal-dev \
        gdal-bin \
        libproj-dev \
        libgeos-dev \
        curl && \
    pip install --no-cache-dir -r /tmp/requirements-mos-pygeoapi.txt && \
    rm /tmp/requirements-mos-pygeoapi.txt && \
    mkdir -p /app/openapi && \
    chmod +x /usr/local/bin/start.sh && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

EXPOSE ${PYGEOAPI_API_PORT}

CMD ["/usr/local/bin/start.sh"]
