FROM python:3.14-slim AS runtime

ARG USER_GID=1000
ARG USER_UID=1000

# Set non-interactive mode for apt-get
ENV DEBIAN_FRONTEND=noninteractive

# STAC API specific environment variables
ENV PROJ_NETWORK=OFF
ENV PYTHONPATH=/app
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV HOST=0.0.0.0
ENV STAC_API_PORT=8081
ENV CORS_ORIGINS=
ENV WEB_CONCURRENCY=10
ENV PYTHONUNBUFFERED=1

# Set the working directory
WORKDIR /app

# Copy wait-for-it and entrypoint scripts
COPY scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY stac-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN mkdir -p /app/scripts && chmod +x /usr/local/bin/wait-for-it.sh /usr/local/bin/entrypoint.sh

# Install dependencies
ENV PROJ_DIR=/usr
RUN --mount=type=bind,source=stac-api/requirements-stac-api.txt,target=/tmp/requirements-stac-api.txt \
    apt-get update && apt-get install -y \
    libpq-dev \
    libgeos-dev \
    libproj-dev \
    curl \
    pkg-config \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* && \
    pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements-stac-api.txt && \
    mkdir -p /app/data

# Create non-root user and set ownership
RUN groupadd --gid ${USER_GID} appuser \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --no-create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

COPY --chown=appuser:appuser stac-api/src /app/stac_api

USER appuser

EXPOSE ${STAC_API_PORT}

# API entrypoint
CMD ["/usr/local/bin/entrypoint.sh"]

FROM runtime AS test
USER root
RUN --mount=type=bind,source=stac-api/requirements-stac-api-test.txt,target=/tmp/requirements-stac-api-test.txt \
    pip install --no-cache-dir -r /tmp/requirements-stac-api-test.txt
USER appuser
COPY --chown=appuser:appuser stac-api/test /app/stac_api/test
COPY --chown=appuser:appuser stac-api/pytest.ini /app/pytest.ini
