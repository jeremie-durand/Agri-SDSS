# Official TiTiler image
FROM ghcr.io/developmentseed/titiler:0.23.1

# Set environment variables
ENV RASTER_API_PORT=8082
ENV HOST=0.0.0.0

# Copy canonical wait-for-it script and entrypoint
COPY scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY raster-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/wait-for-it.sh /usr/local/bin/entrypoint.sh

# Expose port for raster API
EXPOSE ${RASTER_API_PORT}

# Command to wait for the database to be ready before starting TiTiler
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
