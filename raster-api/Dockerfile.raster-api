# Official TiTiler image
FROM ghcr.io/developmentseed/titiler:2.0.5 AS runtime

ARG USER_GID=1000
ARG USER_UID=1000

# Set environment variables
ENV RASTER_API_PORT=8082
ENV HOST=0.0.0.0
ENV PATH="/home/appuser/.local/bin:${PATH}"
ENV PYTHONPATH=/app

# Copy canonical wait-for-it script and entrypoint
COPY --chmod=755 scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY --chmod=755 raster-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh

# Install dependencies
RUN --mount=type=bind,source=raster-api/requirements-raster-api.txt,target=/tmp/requirements-raster-api.txt \
    pip install --no-cache-dir -r /tmp/requirements-raster-api.txt

# Create non-root user and set ownership
RUN mkdir -p /app \
    && groupadd --gid ${USER_GID} appuser \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

# Copy custom application code (extends TiTiler with a /collections endpoint)
COPY --chown=appuser:appuser raster-api/src /app/raster_api

USER appuser

EXPOSE ${RASTER_API_PORT}

# Command to wait for the database to be ready before starting TiTiler
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sh", "-c", "uvicorn raster_api.main:app --host 0.0.0.0 --port ${RASTER_API_PORT:-8082} --root-path ${APP_ROOT_PATH:-}"]

FROM runtime AS test
USER root
RUN --mount=type=bind,source=raster-api/requirements-raster-api-test.txt,target=/tmp/requirements-raster-api-test.txt \
    pip install --no-cache-dir -r /tmp/requirements-raster-api-test.txt
USER appuser
COPY --chown=appuser:appuser raster-api/test /app/raster_api/test
COPY --chown=appuser:appuser raster-api/pytest.ini /app/pytest.ini
