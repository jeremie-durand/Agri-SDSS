# Official TiTiler image
FROM ghcr.io/developmentseed/titiler:2.4.0 AS runtime

ARG USER_GID=1000
ARG USER_UID=1000

# Set environment variables
ENV RASTER_API_PORT=8082
ENV HOST=0.0.0.0
ENV PYTHONPATH=/app
ENV HOME=/tmp

# The Wolfi-based TiTiler image ships its venv without pip, and its busybox
# timeout makes wait-for-it.sh probe the database with nc
USER root
RUN apk upgrade --no-cache \
    && apk add --no-cache netcat-openbsd \
    && python -m ensurepip \
    && python -m pip install --no-cache-dir --upgrade pip

# Copy canonical wait-for-it script and entrypoint
COPY --chmod=755 scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
COPY --chmod=755 raster-api/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh

# Install dependencies
RUN --mount=type=bind,source=raster-api/requirements-raster-api.txt,target=/tmp/requirements-raster-api.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements-raster-api.txt

# Wolfi has no useradd; run as a numeric UID that matches the host data dirs
RUN mkdir -p /app && chown ${USER_UID}:${USER_GID} /app

# Copy custom application code (extends TiTiler with a /collections endpoint)
COPY --chown=${USER_UID}:${USER_GID} raster-api/src /app/raster_api

USER ${USER_UID}:${USER_GID}

EXPOSE ${RASTER_API_PORT}

# Command to wait for the database to be ready before starting TiTiler
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sh", "-c", "uvicorn raster_api.main:app --host 0.0.0.0 --port ${RASTER_API_PORT:-8082} --root-path ${APP_ROOT_PATH:-}"]

FROM runtime AS test
ARG USER_GID=1000
ARG USER_UID=1000
USER root
RUN --mount=type=bind,source=raster-api/requirements-raster-api-test.txt,target=/tmp/requirements-raster-api-test.txt \
    python -m pip install --no-cache-dir -r /tmp/requirements-raster-api-test.txt
USER ${USER_UID}:${USER_GID}
COPY --chown=${USER_UID}:${USER_GID} raster-api/test /app/raster_api/test
COPY --chown=${USER_UID}:${USER_GID} raster-api/pytest.ini /app/pytest.ini
COPY --chown=${USER_UID}:${USER_GID} raster-api/.coveragerc /app/.coveragerc
