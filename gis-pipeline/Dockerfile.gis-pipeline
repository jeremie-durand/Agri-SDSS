FROM python:3.11-slim

# Set non-interactive mode for apt-get
ENV DEBIAN_FRONTEND=noninteractive

# GIS Pipeline specific environment variables
ENV PROJ_NETWORK=OFF
ENV PYTHONPATH=/app
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PYTHONUNBUFFERED=1

# Set the working directory
WORKDIR /app
RUN mkdir -p /app/scripts

# Copy scripts and make them executable
COPY scripts/wait-for-it.sh /usr/local/bin/wait-for-it.sh
RUN chmod +x /usr/local/bin/wait-for-it.sh

# Install build dependencies (GIS-focused)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    git \
    g++ \
    make \
    python3-dev \
    wget \
    curl \
    libspatialindex-dev \
    libsqlite3-dev \
    libgeos-dev \
    libproj-dev \
    libtiff-dev \
    libjpeg-dev \
    libpng-dev \
    libnetcdf-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# GDAL installation
ENV GDAL_VERSION=3.11.3
ENV CPLUS_INCLUDE_PATH=/usr/local/include
ENV C_INCLUDE_PATH=/usr/local/include
ENV PROJ_DIR=/usr

# Clone GDAL and build using CMake
RUN git clone https://github.com/OSGeo/gdal.git \
    && cd gdal \
    && git checkout v${GDAL_VERSION} \
    && mkdir build \
    && cd build \
    && cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
    && ninja \
    && ninja install \
    && ldconfig \
    && cd /app \
    && rm -rf gdal

# Copy pipeline requirements
COPY gis-pipeline/requirements-gis-pipeline.txt ./requirements-gis-pipeline.txt

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir numpy>=2.0 cython \
    && pip install --no-cache-dir -r requirements-gis-pipeline.txt \
    && rm requirements-gis-pipeline.txt \
    && mkdir -p /app/data

# Copy pipeline code
COPY gis-pipeline/src/gis_pipeline /app/gis_pipeline

# Copy entrypoint script
COPY gis-pipeline/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]