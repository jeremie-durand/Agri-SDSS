FROM python:3.11-slim AS runtime

ARG USER_GID=1000
ARG USER_UID=1000

# Set environment variables
ENV PROCESS_API_PORT=5000
ENV PYGEOAPI_API_HOST=0.0.0.0
ENV PYGEOAPI_CONFIG=/app/config/pygeoapi-config.yaml
ENV PYGEOAPI_OPENAPI=/app/openapi/openapi.yaml
ENV PYTHONPATH=/app:${PYTHONPATH}

WORKDIR /app

# Copy files
COPY process-api/config/pygeoapi-config.yaml /app/config/pygeoapi-config.yaml
COPY process-api/config/weather_datasets.yaml /app/config/weather_datasets.yaml
COPY process-api/config/climate_datasets.yaml /app/config/climate_datasets.yaml
COPY process-api/processes /app/processes
COPY process-api/scripts/start.sh /usr/local/bin/start.sh
COPY process-api/scripts/generate_openapi.py /app/generate_openapi.py
# Install dependencies
# NOTE: apt packages below are not version-pinned because Debian apt does not provide
# stable cross-architecture pin strings and Dependabot cannot track them.
RUN --mount=type=bind,source=process-api/requirements-process-api.txt,target=/tmp/requirements-process-api.txt \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgdal-dev \
        gdal-bin \
        libproj-dev \
        libgeos-dev \
        curl \
        gettext-base && \
    pip install --no-cache-dir -r /tmp/requirements-process-api.txt && \
    mkdir -p /app/openapi && \
    chmod +x /usr/local/bin/start.sh && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user and set ownership
RUN groupadd --gid ${USER_GID} appuser \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --no-create-home --shell /bin/bash appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE ${PROCESS_API_PORT}

CMD ["/usr/local/bin/start.sh"]

FROM runtime AS test
USER root
RUN --mount=type=bind,source=process-api/requirements-process-api-test.txt,target=/tmp/requirements-process-api-test.txt \
    pip install --no-cache-dir -r /tmp/requirements-process-api-test.txt
USER appuser
COPY --chown=appuser:appuser process-api/test /app/process_api/test
COPY --chown=appuser:appuser process-api/pytest.ini /app/pytest.ini
