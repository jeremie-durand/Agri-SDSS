# API URLs
STAC_API_URL=http://host.docker.internal:8081 # URL of the STAC API
PYGEOAPI_API_URL=http://host.docker.internal:5000 # URL of the pygeoapi API

# PostgreSQL/PostGIS
POSTGRES_USER=postgres
POSTGRES_PASS=changeme
POSTGRES_DBNAME=postgres
POSTGRES_HOST=database # This is for Docker / Use localhost to connect on local
POSTGRES_PORT=5432 # This is for Docker / Use 5439 to connect on local

# DuckDB
DUCKDB_DATABASE=/data/duckdb/eoapi.duckdb # DuckDB database relative file path
DUCKDB_DATA_DIR=/data/duckdb # Directory for DuckDB data files

# Farm Data Configuration
# Table containing farm geometries (must have 'gid' column and 'geometry' column)
FARM_TABLE_NAME=public.bdppad_2024_4326_sample_stac
FARM_GEOMETRY_COLUMN=geom
FARM_ID_COLUMN=gid

# Earth Observation API Configuration
OPENEO_REFRESH_TOKEN=default_refresh_token_value_here

# Ports
PYGEOAPI_API_PORT=5000
STAC_API_PORT=8081
RASTER_API_PORT=8082
VECTOR_API_PORT=8083
VECTOR_API_CORS_ORIGINS= # Comma-separated allowed CORS origins for the Vector API. Leave empty to block all cross-origin requests. # Example: VECTOR_API_CORS_ORIGINS=https://app.example.com,https://stac.example.com
FRONTEND_PORT=8085
POSTGRES_LOCAL_PORT=5439
