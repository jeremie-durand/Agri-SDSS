# API URLs
STAC_API_URL=http://stac-api:8081 # URL of the STAC API (internal Docker service name)
VECTOR_API_URL=http://vector-api:8083 # URL of the vector API (internal Docker service name) -- used by gis-pipeline to notify it after rebuilding a collection's spatial index

# PostgreSQL/PostGIS
# ── Admin (superuser) — used only for Docker init, healthcheck, and pg_dump backups ──
# POSTGRES_USER stays as "postgres" (the Docker-created superuser); do not use for app connections.
POSTGRES_USER=postgres
POSTGRES_PASS=             # Required: generate with: openssl rand -hex 24
POSTGRES_DBNAME=agri_sdss
POSTGRES_HOST=database     # Use "localhost" for direct local connections
POSTGRES_PORT=5432         # Use 5439 for direct local connections
PGDATA_PATH= # PostgreSQL data directory (relative to container)

# ── Application role — what all services actually connect as ──
# DB_USER is a non-superuser role with SELECT/INSERT/UPDATE/DELETE on public + pgstac schemas.
# Created at first DB init by scripts/001_create_app_role.sh.
DB_USER=agri_sdss
DB_PASS=                   # Required: generate with: openssl rand -hex 24

# DuckDB
DUCKDB_DATABASE=/data/duckdb/eoapi.duckdb # DuckDB database relative file path
DUCKDB_DATA_DIR=/data/duckdb # Directory for DuckDB data files

# Farm Data Configuration
# Table containing farm geometries (must have 'gid' column and 'geometry' column)
FARM_TABLE_NAME=public.my_farm_parcels

# Vector API spatial tables — set these to match your PostGIS schema
PEDO_TABLE_NAME=public.pedo_coverage           # pedological coverage (/pedo-coverage endpoint)
SOM_TABLE_NAME=public.som_field_boundaries     # SOM field polygons (/som-field-match endpoint)
WATER_TABLE_NAME=public.grhq_water_union       # hydrographic features (/water-distance endpoint)
FARM_GEOMETRY_COLUMN=geometry
FARM_ID_COLUMN=gid

# OpenEO refresh token for Copernicus Data Space authentication (REQUIRED for production)
# Tokens expire after approximately 30 days and must be regenerated.
# To obtain a token, run: ./process-api/scripts/get_openeo_token.sh
# The script will output a ready-to-paste line for this variable.
# For local development, you can also use the JSON config file fallback (OPENEO_CONFIG_HOME).
# Do not change the default value here, as it is meant to be overridden by the .env file or environment variables.
OPENEO_REFRESH_TOKEN=default_refresh_token_value_here

# Host
# TODO: When DNS is configured:
#   1. Set HOST_PROTOCOL=https and HOST_URL=your-domain.ca
#   2. In Caddyfile: replace "localhost, agri-sdss.local {" with "your-domain.ca {" and remove "tls internal"
#   3. docker compose restart caddy   ← Let's Encrypt activates automatically
#   CORS: update CORS_ORIGINS and VECTOR_API_CORS_ORIGINS below if you want to restrict to your domain instead of *.
HOST_PROTOCOL=https
HOST_URL=localhost

# Internal ports (no longer exposed directly — Caddy proxies via :443)
# POSTGRES_LOCAL_PORT remains accessible from the server only (127.0.0.1)
PROCESS_API_PORT=5000
STAC_API_PORT=8081
CORS_ORIGINS=*                 # Allowed CORS origins for the STAC API; * = open to all (public API). Set to HOST_PROTOCOL://HOST_URL to restrict to your domain.
RASTER_API_PORT=8082
VECTOR_API_PORT=8083
VECTOR_API_CORS_ORIGINS=*     # Allowed CORS origins for the vector API; * = open to all (public API). Set to https://your-domain.ca to restrict.

# ── Caddy rate limiting (PyGeoAPI) ───────────────────────────────────────────
# Limits are hardcoded in Caddyfile (the caddy-ratelimit module does not
# support environment variables for window/events fields).
# To adjust: edit window/events in Caddyfile, then:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
# Defaults: 10 exec/min and 60 browse/min per IP.
# ─────────────────────────────────────────────────────────────────────────────
STAC_BROWSER_PORT=8085
POSTGRES_LOCAL_PORT=5439

# ── Chatbot ──────────────────────────────────────────────────────────────────
# Pin to a release tag from chatbot-repo. Release-watcher opens a PR when a
# new tag is published.
CHATBOT_VERSION=v0.2.1-alpha
CHATBOT_BACKEND_PORT=8005
CHATBOT_FRONTEND_PORT=3001

# LLM provider — set LLM_PROVIDER to "openai" or "anthropic"
LLM_PROVIDER=openai
LLM_API_KEY=...your-api-key-here...
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=1000

# API authentication — MUST be enabled and API_KEY set for production deployments.
# Generate a key: openssl rand -hex 32
ENABLE_AUTH=false   # WARNING: set to true and configure API_KEY before deploying
API_KEY=change-me-before-deploying

# Weather data source for climate projections
# "planetary_computer" (NASA NEX-GDDP-CMIP6, requires internet) or "open_meteo"
WEATHER_DATA_SOURCE=planetary_computer
OPEN_METEO_API_KEY=

# Rate limiting (per-IP, in-memory, resets on restart)
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_SEARCH=30/minute

# Note: chatbot-backend uses the internal Docker network to reach stac-api:
#   STAC_API_URL=http://stac-api:8080 (set directly in docker-compose.yml)
# The existing STAC_API_URL=http://host.docker.internal:8081 above is for
# gis-pipeline and must not be changed.

SITE_ADDRESS=
ACME_EMAIL=