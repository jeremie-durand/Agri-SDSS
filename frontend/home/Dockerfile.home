FROM nginx:alpine

# Copy HTML templates, static assets and entrypoint
COPY --chmod=644 html/index.html /usr/share/nginx/html/index.html.template
COPY --chmod=644 html/map.html /usr/share/nginx/html/map.html
COPY --chmod=644 html/data.html /usr/share/nginx/html/data.html
COPY --chmod=644 html/report-bug.html /usr/share/nginx/html/report-bug.html
COPY --chmod=644 html/about.html /usr/share/nginx/html/about.html
COPY html/css /usr/share/nginx/html/css
COPY html/js /usr/share/nginx/html/js
COPY --chmod=755 scripts/entrypoint.sh /usr/local/bin/entrypoint.sh

# Ports entrypoint.sh patches into the nginx config (overridden by docker-compose).
# The other proxy targets are fixed in entrypoint.sh.
ENV STAC_API_PORT=8081
ENV RASTER_API_PORT=8082
ENV VECTOR_API_PORT=8083

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
