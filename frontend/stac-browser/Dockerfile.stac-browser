# Official STAC Browser image
FROM ghcr.io/radiantearth/stac-browser:5.1.0

# Upstream's /docker-entrypoint.sh renders the nginx config and runs
# /docker-entrypoint.d/ scripts in order; ours expands the browser config.
COPY --chown=nginx:nginx config/browser_config.js /opt/agri/browser_config.js
COPY --chmod=755 scripts/50-agri-browser-config.sh /docker-entrypoint.d/50-agri-browser-config.sh

# Set environment variables
ENV HOST_PROTOCOL=http
ENV HOST_URL=localhost
ENV STAC_BROWSER_PORT=8080
ENV STAC_API_PORT=8081
ENV RASTER_API_PORT=8082
ENV VECTOR_API_PORT=8083
ENV PROCESS_API_PORT=5000

EXPOSE ${STAC_BROWSER_PORT}
