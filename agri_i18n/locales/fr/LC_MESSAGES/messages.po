#, python-brace-format
msgid ""
"OpenEO authentication failed. The OPENEO_REFRESH_TOKEN env var token is "
"expired or invalid, and the config file fallback also failed. "
"{expiry_note} Please re-run: {script} to obtain a new token."
msgstr ""
"Échec de l'authentification OpenEO. Le jeton de la variable "
"OPENEO_REFRESH_TOKEN est expiré ou invalide, et le recours au fichier de "
"configuration a également échoué. {expiry_note} Veuillez réexécuter : "
"{script} pour obtenir un nouveau jeton."

#: process-api/processes/eo_sentinel_fetch.py:545
#, python-brace-format
msgid ""
"OpenEO authentication failed. No valid refresh token found. Looked for "
"refresh-tokens.json in OPENEO_CONFIG_HOME={config_home}. {expiry_note} "
"Please run: {script} to set up authentication and copy the token to your "
".env file."
msgstr ""
"Échec de l'authentification OpenEO. Aucun jeton de rafraîchissement "
"valide trouvé. Recherche de refresh-tokens.json dans "
"OPENEO_CONFIG_HOME={config_home}. {expiry_note} Veuillez exécuter : "
"{script} pour configurer l'authentification et copier le jeton dans votre"
" fichier .env."

