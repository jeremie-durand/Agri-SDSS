#: chatbot/overrides/backend/sdss_api.py:35
msgid "Invalid or missing API key."
msgstr "Clé d’API invalide ou manquante."

#: chatbot/overrides/backend/sdss_api.py:237
msgid "I was unable to complete the spatial analysis."
msgstr "Je n’ai pas pu compléter l’analyse spatiale."

#: process-api/processes/backend_utils.py:34
#, python-brace-format
msgid "Longitude {value} out of range [-180, 180]"
msgstr "Longitude {value} hors de l’intervalle [-180, 180]"

#: process-api/processes/backend_utils.py:38
#, python-brace-format
msgid "Latitude {value} out of range [-90, 90]"
msgstr "Latitude {value} hors de l’intervalle [-90, 90]"

#: process-api/processes/backend_utils.py:51
#, python-brace-format
msgid "bbox minx ({minx}) must be < maxx ({maxx})"
msgstr "bbox minx ({minx}) doit être < maxx ({maxx})"

#: process-api/processes/backend_utils.py:57
#, python-brace-format
msgid "bbox miny ({miny}) must be < maxy ({maxy})"
msgstr "bbox miny ({miny}) doit être < maxy ({maxy})"

#: process-api/processes/backend_utils.py:67
#, python-brace-format
msgid "'{field}' must be provided when location_type is '{field}'"
msgstr "« {field} » doit être fourni lorsque location_type vaut « {field} »"

#: process-api/processes/location_utils.py:87
#, python-brace-format
msgid "Invalid GeoJSON geometry: {error}"
msgstr "Géométrie GeoJSON invalide : {error}"

#: process-api/processes/location_utils.py:90
msgid "GeoJSON geometry is invalid or empty"
msgstr "La géométrie GeoJSON est invalide ou vide"

#: process-api/processes/location_utils.py:115
#, python-brace-format
msgid "'farm_id' must be a valid integer, got: {value!r}"
msgstr "« farm_id » doit être un entier valide, reçu : {value!r}"

#: process-api/processes/location_utils.py:121
#, python-brace-format
msgid "'farm_id' must be a positive integer, got: {value}"
msgstr "« farm_id » doit être un entier positif, reçu : {value}"

#: process-api/processes/location_utils.py:154
#, python-brace-format
msgid "Farm ID {farm_id} not found in database"
msgstr "Identifiant de ferme {farm_id} introuvable dans la base de données"

#: process-api/processes/climate_backend/models.py:110
#: process-api/processes/climate_backend/models.py:211
#: process-api/processes/weather_backend/models.py:54
#, python-brace-format
msgid "Invalid date format (expected YYYY-MM-DD): {value!r}"
msgstr "Format de date invalide (AAAA-MM-JJ attendu) : {value!r}"

#: process-api/processes/climate_backend/models.py:124
#: process-api/processes/climate_backend/models.py:225
#: process-api/processes/weather_backend/models.py:78
#, python-brace-format
msgid "'start_date' ({start}) must be <= 'end_date' ({end})"
msgstr "« start_date » ({start}) doit être <= « end_date » ({end})"

#: process-api/processes/climate_backend/models.py:236
msgid "'scenario' is required when using a CMIP6 dataset"
msgstr "« scenario » est requis avec un jeu de données CMIP6"

#: process-api/processes/climate_backend/models.py:240
msgid "'model' is required when using a CMIP6 dataset"
msgstr "« model » est requis avec un jeu de données CMIP6"

#: process-api/processes/weather_backend/models.py:65
msgid "'dataset' must be a non-empty string"
msgstr "« dataset » doit être une chaîne non vide"

#: vector-api/src/parquet_router.py:56
msgid ""
"Invalid collection ID. Only alphanumeric characters, underscores, and "
"hyphens are allowed."
msgstr ""
"Identifiant de collection invalide. Seuls les caractères alphanumériques, "
"les traits de soulignement et les traits d’union sont autorisés."

#: vector-api/src/parquet_router.py:65 vector-api/src/parquet_router.py:99
msgid ""
"Parquet service unavailable: DuckDB spatial extension could not be loaded. "
"Please check server configuration."
msgstr ""
"Service Parquet indisponible : l’extension spatiale DuckDB n’a pas pu être "
"chargée. Veuillez vérifier la configuration du serveur."

