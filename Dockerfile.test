FROM python:3.11-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ git curl \
    libgdal-dev libgeos-dev libproj-dev \
    && rm -rf /var/lib/apt/lists/*

# Install requirements from all components
COPY gis-pipeline/requirements-gis-pipeline.txt /tmp/requirements-gis-pipeline.txt
COPY stac-api/requirements-stac-api.txt /tmp/requirements-stac-api.txt
COPY mos-pygeoapi/requirements-mos-pygeoapi.txt /tmp/requirements-mos-pygeoapi.txt
COPY vector-api/requirements-vector-api.txt /tmp/requirements-vector-api.txt

# Install pytest and all component requirements
RUN pip install --no-cache-dir \
    pytest pytest-cov pytest-xdist responses requests \
    -r /tmp/requirements-gis-pipeline.txt \
    -r /tmp/requirements-stac-api.txt \
    -r /tmp/requirements-mos-pygeoapi.txt \
    -r /tmp/requirements-vector-api.txt && \
    rm /tmp/requirements-gis-pipeline.txt \
       /tmp/requirements-stac-api.txt \
       /tmp/requirements-mos-pygeoapi.txt \
       /tmp/requirements-vector-api.txt

# Copy all source code and tests
COPY gis-pipeline/config.yaml /workspace/gis-pipeline/config.yaml
COPY conftest.py /workspace/conftest.py
COPY gis-pipeline /workspace/gis-pipeline
COPY stac-api /workspace/stac-api
COPY vector-api /workspace/vector-api
COPY raster-api /workspace/raster-api
COPY mos-pygeoapi /workspace/mos-pygeoapi
COPY scripts /workspace/scripts
COPY tests_shared /workspace/tests_shared
COPY pytest.ini /workspace/pytest.ini

ENV PYTHONPATH=/workspace
CMD ["pytest", "-v"]
